{
  "include": ["src/code/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "#/*": ["./src/*"]
    },
    "types": ["bun"],
    "strict": true
  }
}
